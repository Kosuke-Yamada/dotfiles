<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ログイン時に yabai --start-service を実行する。
  yabai --stop-service は launchctl disable まで行うため、そのままだと
  再起動後に公式エージェント (com.asmvik.yabai) が読み込まれない。
  このエージェントが毎ログイン時に enable + bootstrap し直す。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.dotfiles.yabai</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH; exec yabai --start-service</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/local.dotfiles.yabai.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/local.dotfiles.yabai.err.log</string>
</dict>
</plist>
