{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(//**/*.pem)",
      "Read(//**/id_rsa*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(npm publish *)",
      "Bash(terraform apply *)",
      "Bash(kubectl apply *)"
    ],
    "allow": [
      "Bash(npm run *)",
      "Bash(pnpm *)",
      "Bash(make *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(git switch *)",
      "Bash(gh pr view *)",
      "Bash(gh issue view *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "claude-mem:babysit": "off",
    "claude-mem:cloud-sync": "off",
    "claude-mem:design-is": "off",
    "claude-mem:how-it-works": "off",
    "claude-mem:knowledge-agent": "off",
    "claude-mem:learn-codebase": "off",
    "claude-mem:oh-my-issues": "off",
    "claude-mem:pathfinder": "off",
    "claude-mem:smart-explore": "off",
    "claude-mem:standup": "off",
    "claude-mem:version-bump": "off",
    "claude-mem:what-the": "off",
    "claude-mem:wowerpoint": "off",
    "related-work-survey": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/herdr-shell-token.sh running",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/herdr-shell-token.sh idle",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/herdr-shell-token.sh reset",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/herdr-shell-token.sh reset",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/s26310/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/statusline-refresh.sh",
            "timeout": 15,
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/herdr-shell-token.sh reset",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "cycloud-plugin@ailab": true,
    "claude-mem@thedotmack": true,
    "eli5@claude-community": true,
    "pb-skills@playbook": true
  },
  "extraKnownMarketplaces": {
    "ailab": {
      "source": {
        "source": "git",
        "url": "git@github.com:CyberAgentAILab/claude-plugins.git"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    },
    "playbook": {
      "source": {
        "source": "github",
        "repo": "Kosuke-Yamada/playbook"
      }
    }
  },
  "language": "japanese",
  "outputStyle": "Concise",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "auto",
  "timeFormat": "24-hour",
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "autoCompactWindow": 500000,
  "skipAutoPermissionPrompt": true,
  "worktree": {
    "baseRef": "fresh"
  }
}
