{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(uv *)",
      "Bash(ruff *)",
      "Write(*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:npmjs.org)",
      "WebFetch(domain:note.com)"
    ],
    "deny": [
      "Bash(ssh *)",
      "Read(id_rsa*)",
      "Read(**/*secret*)",
      "Edit(**/*secret*)"
    ],
    "ask": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Read(**/*key.*)",
      "Read(**/*_key*)",
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(git merge:*)",
      "Bash(sed -i:*)",
      "Bash(sudo:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(rm -rf:*)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "claude-mem:babysit": "off",
    "claude-mem:cloud-sync": "off",
    "claude-mem:design-is": "off",
    "claude-mem:how-it-works": "off",
    "claude-mem:knowledge-agent": "off",
    "claude-mem:learn-codebase": "off",
    "claude-mem:oh-my-issues": "off",
    "claude-mem:pathfinder": "off",
    "claude-mem:smart-explore": "off",
    "claude-mem:standup": "off",
    "claude-mem:version-bump": "off",
    "claude-mem:what-the": "off",
    "claude-mem:wowerpoint": "off",
    "related-work-survey": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/s26310/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/statusline-refresh.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/scripts/statusline.sh",
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "cycloud-plugin@ailab": true,
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "ailab": {
      "source": {
        "source": "git",
        "url": "git@github.com:CyberAgentAILab/claude-plugins.git"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "language": "japanese",
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "theme": "auto",
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true
}
