#!/bin/zsh

# ==============================================================================
# History
# ==============================================================================
alias history='fc -liD 1'  # 履歴を日時付きで表示
alias hist='fc -liD 1'

# ==============================================================================
# Base commands (with nocorrect and safety options)
# ==============================================================================
alias cd="nocorrect cd"
alias cp="nocorrect cp -i"       # 上書き前に確認
alias mv="nocorrect mv -i"       # 上書き前に確認
alias rm="nocorrect rm -i"       # 削除前に確認
alias ln="nocorrect ln -i"       # 上書き前に確認
alias mkdir="nocorrect mkdir -p" # 親ディレクトリも作成
alias gcc="nocorrect gcc"
alias man="nocorrect man"
# macOSはBSD ls (-G)、LinuxはGNU ls (--color)
if [[ "$(uname)" == "Darwin" ]]; then
    alias ls="nocorrect ls -G"
else
    alias ls="nocorrect ls --color"
fi
alias sl="ls"                    # typo対策

# ==============================================================================
# Modern CLI replacements
# ==============================================================================
type htop >/dev/null 2>&1 && alias top="htop"   # プロセスモニタ
type rg >/dev/null 2>&1 && alias grep="rg"      # ripgrep
type cw >/dev/null 2>&1 && alias wc="cw"        # 高速wc
type fd >/dev/null 2>&1 && alias find="fd"      # 高速find
type bat >/dev/null 2>&1 && alias cat="bat"     # シンタックスハイライト付きcat

# ==============================================================================
# eza (modern ls replacement)
# ==============================================================================
if type eza >/dev/null 2>&1; then
    alias ei="eza --icons --git"
    alias ea="eza -la --icons --git"
    alias ee="eza -aahl --icons --git"
    alias et="eza -T -L 3 -a -I 'node_modules|.git|.cache' --icons"
    alias ls="ei"    # 基本表示
    alias la="ea"    # 全ファイル表示
    alias ll="ee"    # 詳細表示
    alias tree="eza -T --icons"
fi

# ==============================================================================
# Directory navigation
# ==============================================================================
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ......="cd ../../../../.."
alias .......="cd ../../../../../.."

# ==============================================================================
# Git
# ==============================================================================
alias gui="gitui"              # Git TUI

# Basic commands
alias ga="git add"
alias gaa="git add -A"         # 全ての変更をステージ
alias gc="git commit"
alias gcm="git commit -m"      # メッセージ付きコミット
alias gf="git fetch"
alias gm="git merge"
alias gps="git push"
alias gpl="git pull"

# Branch & Switch
alias gb="git branch"
alias gsw="git switch"
alias gswc="git switch -c"     # 新規ブランチ作成

# Diff & Log
alias gd="git diff"
alias gl="git log"
alias glo="git log --oneline"  # 1行表示

# Status & Restore
alias gst="git status -u"      # untracked含む
alias grs="git restore"

# GitHub CLI
alias gbr="gh browse"          # ブラウザでリポジトリを開く

# Update all branches
alias gua="git fetch origin && git checkout dev && git pull origin dev && git checkout main && git pull origin main && git checkout -"

# ==============================================================================
# tmux
# ==============================================================================
alias tmuxn="tmux new -s"      # 新規セッション作成 (tmuxn <name>)
alias tmuxl="tmux ls"          # セッション一覧
alias tmuxa="tmux a -t"        # セッション再接続 (tmuxa <name>)

# セッション削除 (tmuxd <name> or tmuxd all)
tmuxd() {
    if [[ "$1" == "all" ]]; then
        tmux kill-server
    else
        tmux kill-session -t "$1"
    fi
}

# ==============================================================================
# herdr
# ==============================================================================
alias hd="herdr"                       # 起動 / デフォルトセッションにアタッチ
alias hdn="herdr --session"            # 新規/名前付きセッション作成・アタッチ (hdn <name>)
alias hda="herdr session attach"       # セッション再接続 (hda <name>)
alias hdl="herdr session list"         # セッション一覧

# セッション削除 (hdd <name> or hdd all)
# session delete は停止済みセッションのみ対象のため、stop してから delete する
hdd() {
    _hdd_one() { herdr session stop "$1" 2>/dev/null; herdr session delete "$1"; }
    if [[ "$1" == "all" ]]; then
        herdr session list 2>/dev/null | awk 'NR>1 {print $1}' | while read -r _s; do
            [[ -n "$_s" ]] && _hdd_one "$_s"
        done
    else
        _hdd_one "$1"
    fi
}

# ==============================================================================
# Utils
# ==============================================================================
type nvidia-smi >/dev/null 2>&1 && alias ns="nvidia-smi"  # GPU状態確認
