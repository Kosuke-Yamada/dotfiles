#!/usr/bin/perl
use strict;
use warnings;
use Fcntl qw(:flock SEEK_SET);
use File::Temp qw(tempfile);
use IO::Handle;
use POSIX qw(WNOHANG);
use Time::HiRes qw(time sleep);

# 通常操作は2秒で打ち切るが、再起動の完了は最大30秒待つ。
# 復旧中の入力は溜めずに終了する。flock は異常終了時にも解放される。
my $yabai = $ENV{YABAI_RUN_BIN} // '/opt/homebrew/bin/yabai';
sub seconds {
    my ($name, $default) = @_;
    my $value = $ENV{$name} // $default;
    die "yabai-run: $name must be a positive number\n"
        unless $value =~ /\A\d+(?:\.\d+)?\z/ && $value > 0;
    return $value;
}
my $timeout = seconds('YABAI_RUN_TIMEOUT', 2);
my $ready_timeout = seconds('YABAI_RUN_READY_TIMEOUT', 30);
my $restart_timeout = seconds('YABAI_RUN_RESTART_TIMEOUT', 10);
my $lock_path = ($ENV{TMPDIR} // '/tmp') . "/yabai-run-$<.lock";
open my $lock, '+>>', $lock_path or die "yabai-run: $lock_path: $!\n";

sub generation {
    seek($lock, 0, SEEK_SET) or die "yabai-run: seek: $!\n";
    return 0 + (<$lock> // 0);
}

# 親プロセス側で期限を管理し、タイムアウトしたクライアントを必ず回収する。
# エラー出力は保持し、接続失敗と通常の操作エラーを区別する。
sub run {
    my ($limit, $quiet, @args) = @_;
    my ($err) = tempfile(UNLINK => 1);
    my $pid = fork();
    die "yabai-run: fork: $!\n" unless defined $pid;
    if ($pid == 0) {
        open STDERR, '>&', $err or die "redirect stderr: $!";
        if ($quiet) {
            open STDOUT, '>', '/dev/null' or die "redirect stdout: $!";
        }
        exec {$yabai} $yabai, @args;
        die "yabai-run: exec $yabai: $!\n";
    }
    my $deadline = time + $limit;
    my $rc;
    while (1) {
        my $result = waitpid($pid, WNOHANG);
        if ($result == $pid) {
            $rc = ($? & 127) ? 128 + ($? & 127) : $? >> 8;
            last;
        }
        die "yabai-run: waitpid: $!\n" if $result == -1;
        if (time >= $deadline) {
            kill 'KILL', $pid;
            waitpid($pid, 0);
            $rc = 142;
            last;
        }
        sleep 0.01;
    }
    seek($err, 0, SEEK_SET);
    local $/;
    my $message = <$err> // '';
    return ($rc, $message);
}

# 再起動中は即終了。開始時の世代を記録し、遅れてタイムアウトした別の
# コマンドが、復旧したばかりのサービスを再び再起動するのを防ぐ。
flock($lock, LOCK_SH | LOCK_NB) or exit 75;
my $generation = generation();
flock($lock, LOCK_UN) or die "yabai-run: unlock: $!\n";
my ($rc, $error) = run($timeout, 0, '-m', @ARGV);
if ($rc != 142 && $error !~ /yabai-msg: failed to connect to socket/) {
    print STDERR $error;
    exit $rc;
}

flock($lock, LOCK_EX | LOCK_NB) or exit 75;
exit 75 if generation() != $generation;
seek($lock, 0, SEEK_SET) or die "yabai-run: seek: $!\n";
truncate($lock, 0) or die "yabai-run: truncate: $!\n";
print {$lock} $generation + 1, "\n";
$lock->flush();
print STDERR "yabai-run: 応答がないため yabai を再起動します\n";
($rc, $error) = run($restart_timeout, 0, '--restart-service');
if ($rc != 0) {
    print STDERR $error, "yabai-run: 再起動に失敗しました (exit $rc)\n";
    exit $rc;
}

my $deadline = time + $ready_timeout;
while (time < $deadline) {
    my $remaining = $deadline - time;
    ($rc, $error) = run($remaining < $timeout ? $remaining : $timeout, 1,
                        '-m', 'query', '--spaces', '--space');
    if ($rc == 0) {
        # 復旧を確認してから元の操作を1回だけ再試行する。
        ($rc, $error) = run($timeout, 0, '-m', @ARGV);
        print STDERR $error;
        exit $rc;
    }
    sleep 0.2 if time < $deadline;
}
print STDERR "yabai-run: 再起動後 ${ready_timeout}s 経っても応答しません\n";
exit 1;
