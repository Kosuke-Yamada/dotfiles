# ===========================================
# skhd 設定ファイル
# ===========================================
# 修飾キー: cmd, alt (option), ctrl, shift, fn
# hyper = cmd + alt + ctrl + shift
# meh = alt + ctrl + shift
#
# 注: yabairc の layout = float の場合、focus/swap/resize/layout 系は
#     一部のコマンドが期待通りに動作しないことがあります。

# ===========================================
# アプリケーション起動
# ===========================================
alt - return : open -na "Ghostty"
alt - b      : open -na "Arc"
alt - e      : open -na "Finder"

# ===========================================
# ウィンドウフォーカス移動（HJKL）
# ===========================================
alt - h : $HOME/.local/bin/yabai-run window --focus west
alt - j : $HOME/.local/bin/yabai-run window --focus south
alt - k : $HOME/.local/bin/yabai-run window --focus north
alt - l : $HOME/.local/bin/yabai-run window --focus east

# ===========================================
# ウィンドウ移動（スワップ）
# ===========================================
shift + alt - h : $HOME/.local/bin/yabai-run window --swap west
shift + alt - j : $HOME/.local/bin/yabai-run window --swap south
shift + alt - k : $HOME/.local/bin/yabai-run window --swap north
shift + alt - l : $HOME/.local/bin/yabai-run window --swap east

# ===========================================
# ウィンドウサイズ変更（100px ステップ・拡大/縮小）
# ===========================================
# 両辺を同時に動かして中央を基準に拡大/縮小する。
# こうすることで片方の辺が画面端に達していても、もう片方の辺が動くため
# float レイアウトでも「効かなくなる」状況を避けられる。
# h: 幅を縮める / l: 幅を広げる / k: 高さを広げる / j: 高さを縮める
ctrl + alt - h : $HOME/.local/bin/yabai-run window --resize left:50:0 ; $HOME/.local/bin/yabai-run window --resize right:-50:0
ctrl + alt - l : $HOME/.local/bin/yabai-run window --resize left:-50:0 ; $HOME/.local/bin/yabai-run window --resize right:50:0
ctrl + alt - k : $HOME/.local/bin/yabai-run window --resize top:0:-50 ; $HOME/.local/bin/yabai-run window --resize bottom:0:50
ctrl + alt - j : $HOME/.local/bin/yabai-run window --resize top:0:50 ; $HOME/.local/bin/yabai-run window --resize bottom:0:-50

# ===========================================
# ウィンドウ配置（alt + cmd + 矢印）
# ===========================================
# 右半分に配置
alt + cmd - right : $HOME/.local/bin/yabai-run window --grid 1:2:1:0:1:1

# 左半分に配置
alt + cmd - left : $HOME/.local/bin/yabai-run window --grid 1:2:0:0:1:1

# 上半分に配置
alt + cmd - up : $HOME/.local/bin/yabai-run window --grid 2:1:0:0:1:1

# 下半分に配置
alt + cmd - down : $HOME/.local/bin/yabai-run window --grid 2:1:0:1:1:1

# 全画面に配置（JISキーボード: _ キー）
alt + cmd - 0x5E : $HOME/.local/bin/yabai-run window --grid 1:1:0:0:1:1

# ===========================================
# スペース（デスクトップ）操作
# ===========================================
alt - 1 : $HOME/.local/bin/yabai-run space --focus 1
alt - 2 : $HOME/.local/bin/yabai-run space --focus 2
alt - 3 : $HOME/.local/bin/yabai-run space --focus 3
alt - 4 : $HOME/.local/bin/yabai-run space --focus 4
alt - 5 : $HOME/.local/bin/yabai-run space --focus 5

shift + alt - 1 : $HOME/.local/bin/yabai-run window --space 1
shift + alt - 2 : $HOME/.local/bin/yabai-run window --space 2
shift + alt - 3 : $HOME/.local/bin/yabai-run window --space 3
shift + alt - 4 : $HOME/.local/bin/yabai-run window --space 4
shift + alt - 5 : $HOME/.local/bin/yabai-run window --space 5

# ===========================================
# ウィンドウレイアウト
# ===========================================
alt - f : $HOME/.local/bin/yabai-run window --toggle zoom-fullscreen
alt - t : $HOME/.local/bin/yabai-run window --toggle float

ctrl + alt - b : $HOME/.local/bin/yabai-run space --layout bsp
ctrl + alt - s : $HOME/.local/bin/yabai-run space --layout stack
ctrl + alt - f : $HOME/.local/bin/yabai-run space --layout float

# ===========================================
# Ghostty Quick Terminal（Ctrl+G）
# ===========================================
# Ghosttyのグローバルキーバインドはスリープ復帰後に無効化される問題があるため、
# skhd経由でメニューアイテムをクリックして呼び出す
ctrl - g : osascript -e 'tell application "System Events" to tell process "Ghostty" to click menu item "Quick Terminal" of menu "View" of menu bar 1'

# ===========================================
# その他
# ===========================================
# 設定リロード
ctrl + alt - r : skhd --reload

# yabai 復旧（再起動）
# yabai サーバはスリープ復帰や特定アプリの Accessibility 応答待ちなどを
# きっかけにハングし、resize/move/focus などの操作コマンドが数十秒ブロック
# されることがある（query は正常に返るのが特徴）。動きが重い/効かないと
# 感じたら、このキーで即座にサービスを再起動して復旧する。
# 通常のバインドは yabai-run 経由で 2 秒のタイムアウト付きで実行し、
# タイムアウト時は自動で再起動・再試行する（src/.local/bin/yabai-run）。
ctrl + alt - y : /opt/homebrew/bin/yabai --restart-service
